{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run payroll backend",
			"type": "shell",
			"command": "mvn",
			"args": [
				"-f",
				"backend\\pom.xml",
				"spring-boot:run"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run payroll frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run payroll frontend local",
			"type": "shell",
			"command": "Set-Location frontend; npm run dev -- --host 127.0.0.1",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}